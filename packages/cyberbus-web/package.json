{
  "name": "@cyberbus/web",
  "version": "0.2.0",
  "description": "Browser SDK for CyberBus overlay TCP connectivity through EasyTier WebAssembly",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@easytier/browser": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@easytier/browser": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
